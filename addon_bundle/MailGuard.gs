/**
 * MailGuard add-on - ALL files in one
 * (generated by scripts/bundle_addon.py; edit addon/*.gs instead).
 * Paste this whole file into a single script file in the Apps Script editor.
 */

// ===================================================================== Actions.gs

/**
 * Response actions: Move to Trash (with Undo), Block sender (with confirmation) and
 * Report to SecOps.
 *
 * Security rules for every action:
 *  - The target is re-derived on the server side of Apps Script from the message itself
 *    (by id), never taken from text the card carried, and the sender address is strictly
 *    validated before it goes into a Gmail filter.
 *  - Destructive actions are reversible (Undo for Trash) or confirmed (Block).
 *  - Blocking a *forged* address is discouraged: it would filter mail from the real owner,
 *    not from the attacker. The confirmation card says so and offers "Report" instead.
 *  - Every action is logged by type only (no addresses, no content).
 */

function actionMessageId_(e) {
  var id = (e && e.gmail && e.gmail.messageId) || (e && e.parameters && e.parameters.messageId) || '';
  if (!/^[0-9a-zA-Z_-]{8,64}$/.test(id)) {
    throw new Error('invalid message id');
  }
  return id;
}

function notify_(text, navigation) {
  var b = CardService.newActionResponseBuilder()
    .setNotification(CardService.newNotification().setText(text));
  if (navigation) {
    b.setNavigation(navigation);
  }
  return b.build();
}

function audit_(action, outcome) {
  console.info('action=' + action + ' outcome=' + outcome); // never the address or content
}

/** The sender address from the message's own From header, or null if it isn't a plain address. */
function senderOf_(messageId) {
  var meta = Gmail.Users.Messages.get('me', messageId, { format: 'metadata', metadataHeaders: ['From'] });
  var from = ((meta && meta.payload && meta.payload.headers) || []).filter(function (h) {
    return String(h.name).toLowerCase() === 'from';
  })[0];
  var email = emailFromHeader_(from && from.value);
  return isPlainEmail_(email) ? email : null;
}

function messageIdHeaderOf_(messageId) {
  try {
    var meta = Gmail.Users.Messages.get('me', messageId, { format: 'metadata', metadataHeaders: ['Message-ID'] });
    var h = ((meta && meta.payload && meta.payload.headers) || [])[0];
    return h ? clean_(h.value, 256) : '';
  } catch (err) {
    return '';
  }
}

function onCancel(e) {
  setLocale_(e);
  return CardService.newActionResponseBuilder().setNavigation(CardService.newNavigation().popCard()).build();
}

// ----------------------------------------------------------------------------- Trash

function onTrashMessage(e) {
  setLocale_(e);
  if (!actionsEnabled_()) {
    return notify_(t_('n.disabled'));
  }
  var id = actionMessageId_(e);
  try {
    Gmail.Users.Messages.trash('me', id);
  } catch (err) {
    audit_('trash', 'error');
    return notify_(t_('n.trash_fail'));
  }
  audit_('trash', 'ok');
  return notify_(t_('n.trashed'), CardService.newNavigation().updateCard(buildTrashedCard_(id)));
}

function onUndoTrash(e) {
  setLocale_(e);
  var id = actionMessageId_(e);
  try {
    Gmail.Users.Messages.untrash('me', id);
  } catch (err) {
    audit_('untrash', 'error');
    return notify_(t_('n.untrash_fail'));
  }
  audit_('untrash', 'ok');
  var r = cachedResult_(id);
  var card = r ? buildResultCard_(r, { cached: true, messageId: id }) : buildHomepageCard_();
  return notify_(t_('n.restored'), CardService.newNavigation().updateCard(card));
}

// ----------------------------------------------------------------------------- Block

/** Step 1: show what will happen, with a warning when the address is forged. */
function onConfirmBlock(e) {
  setLocale_(e);
  if (!actionsEnabled_()) {
    return notify_(t_('n.disabled'));
  }
  var id = actionMessageId_(e);
  var sender = senderOf_(id);
  if (!sender) {
    return notify_(t_('n.malformed_report'));
  }
  var r = cachedResult_(id);
  var identity = r && r.sender && r.sender.email === sender ? r.sender : null;
  return CardService.newActionResponseBuilder()
    .setNavigation(CardService.newNavigation().pushCard(buildBlockConfirmCard_(id, sender, identity)))
    .build();
}

/** Step 2: create a Gmail filter that sends future mail from this exact address to Trash. */
function onBlockSender(e) {
  setLocale_(e);
  if (!actionsEnabled_()) {
    return notify_(t_('n.disabled'));
  }
  var id = actionMessageId_(e);
  var sender = senderOf_(id); // re-derived, never taken from the card
  if (!sender) {
    return notify_(t_('n.malformed'));
  }
  var me = String(Session.getActiveUser().getEmail() || '').toLowerCase();
  if (sender === me) {
    return notify_(t_('n.own'));
  }
  try {
    var existing = (Gmail.Users.Settings.Filters.list('me').filter || []).some(function (f) {
      return f.criteria && String(f.criteria.from || '').toLowerCase() === sender;
    });
    if (existing) {
      audit_('block', 'already');
      recordSenderAction_(sender, 'b');
      return notify_(t_('n.already'), CardService.newNavigation().popCard());
    }
    Gmail.Users.Settings.Filters.create({
      criteria: { from: sender },
      action: { addLabelIds: ['TRASH'], removeLabelIds: ['INBOX'] }
    }, 'me');
  } catch (err) {
    audit_('block', 'error');
    return notify_(t_('n.block_fail'));
  }
  audit_('block', 'ok');
  recordSenderAction_(sender, 'b');
  return notify_(t_('n.blocked', { sender: clean_(sender, 80) }),
    CardService.newNavigation().popCard());
}

// ----------------------------------------------------------------------------- Report

function onReportSecOps(e) {
  setLocale_(e);
  var id = actionMessageId_(e);
  try {
    var config = getConfig_();
    var r = cachedResult_(id) || analyzeMessage_(e, id);
    var reportId = reportToSecOps_(reportPayload_(r, messageIdHeaderOf_(id)), config);
    r.reported_as = reportId;
    // Remember the report against the sender only if the address is genuine (authenticated):
    // reporting a forged email must not mark the real owner of the address.
    var reportedSender = senderOf_(id); // re-derived from the message, like Block
    if (reportedSender && r.sender && r.sender.authenticated && r.sender.email === reportedSender) {
      recordSenderAction_(reportedSender, 'r');
    }
    cacheResult_(id, r);
    audit_('report', 'ok');
    return notify_(t_('n.reported', { ref: reportId }),
      CardService.newNavigation().updateCard(buildResultCard_(r, { cached: true, messageId: id })));
  } catch (err) {
    audit_('report', 'error');
    return notify_(t_('n.report_fail'));
  }
}

// ===================================================================== Alerts.gs

/**
 * Background protection: scan new mail on a schedule and alert the user about dangerous emails
 * they have not opened yet.
 *
 * A Gmail add-on normally runs only while the user is looking at a message. A phishing email
 * that is never opened in the side panel would never be scored. With alerts switched on (button
 * on the home card), a time-driven trigger scans new inbox mail and, for every email at or above
 * the alert threshold:
 *   1. labels it "MailGuard/⚠ Malicious" so it stands out in the inbox,
 *   2. sends the user an alert email (to themselves) explaining why - with no clickable link
 *      from the dangerous email, only a link that opens it in Gmail,
 *   3. optionally (ALERT_QUARANTINE=true) moves it out of the inbox - reversible: it keeps the
 *      label, and "Move to Inbox" brings it back,
 *   4. optionally (ALERT_AUTO_REPORT=true) files a SecOps report through the backend.
 *
 * Script properties (all optional):
 *   ALERT_MIN_SCORE     score that requires intervention (default 70; 65-100 is "malicious")
 *   ALERT_QUARANTINE    "true" to also move alerted mail out of the inbox
 *   ALERT_AUTO_REPORT   "true" to also report alerted mail to SecOps automatically
 *   ALERT_INTERVAL_MIN  scan interval in minutes: 5, 10, 15 or 30 (default 10). Google may limit
 *                       add-on triggers to once an hour; then the hourly schedule is used.
 *
 * Safety: the scan reads mail with the same Gmail API scope as the history lookup; nothing is
 * stored except salted hashes of alerted message ids (to never alert twice) and the scan time.
 */

var ALERT_LABEL_ = 'MailGuard/⚠ Malicious';
var ALERT_SUBJECT_TAG_ = 'MailGuard alert'; // also used to skip our own alert emails
var ALERT_MAX_PER_RUN_ = 15; // stays well under the backend's per-client rate limit and the 6-minute run limit
var ALERT_MAX_REMEMBERED_ = 300;

// ----------------------------------------------------------------------------- settings

function alertSettings_() {
  var p = PropertiesService.getScriptProperties();
  var min = parseInt(p.getProperty('ALERT_MIN_SCORE') || '70', 10);
  var interval = parseInt(p.getProperty('ALERT_INTERVAL_MIN') || '10', 10);
  return {
    minScore: isFinite(min) ? Math.max(30, Math.min(100, min)) : 70, // never alert on "safe"
    quarantine: p.getProperty('ALERT_QUARANTINE') === 'true',
    autoReport: p.getProperty('ALERT_AUTO_REPORT') === 'true',
    interval: [5, 10, 15, 30].indexOf(interval) !== -1 ? interval : 10
  };
}

function alertsEnabled_() {
  return ScriptApp.getProjectTriggers().some(function (t) {
    return t.getHandlerFunction() === 'scanNewMailForAlerts';
  });
}

/** Home-card button: switch background alerts on or off for this user. */
function onToggleAlerts(e) {
  setLocale_(e);
  var on;
  try {
    on = alertsEnabled_() ? disableAlerts_() : enableAlerts_();
  } catch (err) {
    console.warn('alerts toggle failed: ' + err.name);
    return notify_(t_('alerts.toggle_fail'));
  }
  return notify_(t_(on ? 'alerts.enabled' : 'alerts.disabled'),
    CardService.newNavigation().updateCard(buildHomepageCard_()));
}

function enableAlerts_() {
  disableAlerts_();
  var interval = alertSettings_().interval;
  try {
    ScriptApp.newTrigger('scanNewMailForAlerts').timeBased().everyMinutes(interval).create();
  } catch (err) {
    // Add-on time-driven triggers may be limited to once an hour.
    ScriptApp.newTrigger('scanNewMailForAlerts').timeBased().everyHours(1).create();
  }
  // Start from "now": alerts are about new mail, not a sweep of the whole mailbox.
  PropertiesService.getUserProperties().setProperty('mg:alerts:since', String(Math.floor(Date.now() / 1000) - 3600));
  return true;
}

function disableAlerts_() {
  ScriptApp.getProjectTriggers().forEach(function (t) {
    if (t.getHandlerFunction() === 'scanNewMailForAlerts') {
      ScriptApp.deleteTrigger(t);
    }
  });
  return false;
}

// ----------------------------------------------------------------------------- the scan

/**
 * Time-driven entry point. Never throws: a failing run is logged and the next one retries,
 * because the "since" mark only moves forward after a successful run.
 */
function scanNewMailForAlerts() {
  var lock = LockService.getUserLock();
  if (!lock.tryLock(1000)) {
    return; // a previous run is still going
  }
  try {
    MG_LOCALE_ = normalizeLocale_(PropertiesService.getUserProperties().getProperty('mg:locale') || 'en');
    var config = getConfig_();
    var settings = alertSettings_();
    var props = PropertiesService.getUserProperties();
    var startedAt = Math.floor(Date.now() / 1000);
    var since = parseInt(props.getProperty('mg:alerts:since') || String(startedAt - 3600), 10);
    // after: takes epoch seconds. Our own alert emails are excluded by subject.
    var query = 'in:inbox after:' + since + ' -subject:"' + ALERT_SUBJECT_TAG_ + '"';
    var ids = gmailSearchIds_(query, ALERT_MAX_PER_RUN_, false);
    var alerted = 0;
    for (var i = 0; i < ids.length; i++) {
      if (alreadyAlerted_(ids[i])) {
        continue;
      }
      try {
        if (scanOne_(ids[i], config, settings)) {
          alerted++;
        }
      } catch (err) {
        console.warn('background scan of one message failed: ' + err.name + ' ' + (err.kind || ''));
      }
    }
    // If the page was full, more mail may be waiting: keep the mark so the next run continues.
    if (ids.length < ALERT_MAX_PER_RUN_) {
      props.setProperty('mg:alerts:since', String(startedAt - 120)); // small overlap; duplicates are skipped
    }
    console.info('background scan: checked=' + ids.length + ' alerted=' + alerted);
  } catch (err) {
    console.warn('background scan failed: ' + err.name);
  } finally {
    lock.releaseLock();
  }
}

/** Analyse one message; alert if it requires intervention. Returns true when an alert was raised. */
function scanOne_(messageId, config, settings) {
  var msg = Gmail.Users.Messages.get('me', messageId, { format: 'full' });
  var payload = payloadFromApiMessage_(msg, messageId, config);
  if (!payload) {
    return false;
  }
  var started = Date.now();
  var result = callBackend_(payload, config);
  result.client_ms = Date.now() - started;
  cacheResult_(messageId, result); // opening the email later is instant
  var fromEmail = emailFromHeader_(headerValue_(msg, 'From'));
  if (config.senderHistory && result.sender && result.sender.authenticated && result.sender.email === fromEmail) {
    recordVerdict_(fromEmail, messageId, result.verdict);
  }
  if (!requiresIntervention_(result, settings)) {
    return false;
  }
  rememberAlerted_(messageId);
  labelAndQuarantine_(messageId, settings.quarantine);
  if (settings.autoReport) {
    try {
      result.reported_as = reportToSecOps_(reportPayload_(result, headerValue_(msg, 'Message-ID')), config);
      cacheResult_(messageId, result);
    } catch (err) {
      console.warn('auto-report failed: ' + err.name);
    }
  }
  sendAlertEmail_(messageId, result, headerValue_(msg, 'Subject'), settings);
  return true;
}

function requiresIntervention_(result, settings) {
  return result.verdict === 'malicious' && result.score >= settings.minScore;
}

// ----------------------------------------------------------------------------- Gmail API -> payload

function headerValue_(msg, name) {
  var lower = name.toLowerCase();
  var h = ((msg && msg.payload && msg.payload.headers) || []).filter(function (x) {
    return String(x.name).toLowerCase() === lower;
  })[0];
  return h ? String(h.value || '') : '';
}

function decodeBody_(data, charset) {
  var bytes = Utilities.base64DecodeWebSafe(String(data || ''));
  try {
    return Utilities.newBlob(bytes).getDataAsString(charset || 'UTF-8');
  } catch (err) {
    return Utilities.newBlob(bytes).getDataAsString('UTF-8');
  }
}

function charsetOf_(part) {
  var ct = ((part.headers || []).filter(function (h) { return String(h.name).toLowerCase() === 'content-type'; })[0] || {}).value;
  var m = String(ct || '').match(/charset="?([A-Za-z0-9_\-]{1,40})"?/i);
  return m ? m[1] : 'UTF-8';
}

/**
 * The same request the side panel builds (Extract.gs), but from the Gmail API's "full" view,
 * because a background run has no "current message" to read through GmailApp.
 */
function payloadFromApiMessage_(msg, messageId, config) {
  if (!msg || !msg.payload) {
    return null;
  }
  var text = '';
  var html = '';
  var attachments = [];
  var inspectedBytes = 0;
  var stack = [msg.payload];
  var visited = 0;
  while (stack.length && visited++ < 500) { // bounded walk: a crafted MIME tree can't loop us
    var part = stack.shift();
    (part.parts || []).forEach(function (p) { stack.push(p); });
    var mime = String(part.mimeType || '').toLowerCase();
    var body = part.body || {};
    if (part.filename && attachments.length < MG.MAX_ATTACHMENTS) {
      var bytes = null;
      if (body.attachmentId && (body.size || 0) <= 25 * 1024 * 1024) {
        var att = Gmail.Users.Messages.Attachments.get('me', messageId, body.attachmentId);
        bytes = Utilities.base64DecodeWebSafe(att.data || '');
      } else if (body.data) {
        bytes = Utilities.base64DecodeWebSafe(body.data);
      }
      if (!bytes) {
        continue; // too large to fetch here; the side panel (opening the email) still sees it
      }
      var name = String(part.filename);
      var item = {
        filename: safeSlice_(name, 512),
        content_type: String(part.mimeType || 'application/octet-stream').slice(0, 255),
        size: bytes.length,
        sha256: sha256Hex_(bytes),
        content_b64: null
      };
      if (MG.INSPECTABLE_EXT.indexOf(extensionOf_(name)) !== -1 && bytes.length <= MG.MAX_INSPECT_BYTES &&
          inspectedBytes + bytes.length <= MG.MAX_INSPECT_TOTAL_BYTES) {
        item.content_b64 = Utilities.base64Encode(bytes);
        inspectedBytes += bytes.length;
      }
      attachments.push(item);
    } else if (mime === 'text/plain' && body.data && !text) {
      text = decodeBody_(body.data, charsetOf_(part));
    } else if (mime === 'text/html' && body.data && !html) {
      html = decodeBody_(body.data, charsetOf_(part));
    }
  }
  var headers = (msg.payload.headers || []).map(function (h) { return h.name + ': ' + h.value; }).join('\r\n');
  var senderEmail = emailFromHeader_(headerValue_(msg, 'From'));
  var userEmail = Session.getActiveUser().getEmail() || '';
  return {
    client_version: 'addon-' + MG.VERSION,
    raw_headers: safeSlice_(headers, MG.MAX_HEADER_CHARS),
    text_body: safeSlice_(text, MG.MAX_TEXT_CHARS),
    html_body: safeSlice_(html, MG.MAX_HTML_CHARS),
    attachments: attachments,
    sender_history: config.senderHistory ? getSenderHistory_(senderEmail, messageId) : null,
    recipient_domain: userEmail.indexOf('@') > 0 ? userEmail.split('@')[1].toLowerCase() : '',
    locale: MG_LOCALE_
  };
}

// ----------------------------------------------------------------------------- actions

function alertLabelId_() {
  var labels = (Gmail.Users.Labels.list('me').labels || []);
  var existing = labels.filter(function (l) { return l.name === ALERT_LABEL_; })[0];
  if (existing) {
    return existing.id;
  }
  var label = { name: ALERT_LABEL_, labelListVisibility: 'labelShow', messageListVisibility: 'show' };
  try {
    return Gmail.Users.Labels.create(Object.assign({ color: { backgroundColor: '#cc3a21', textColor: '#ffffff' } }, label),
      'me').id;
  } catch (err) {
    return Gmail.Users.Labels.create(label, 'me').id; // colour palettes differ between accounts
  }
}

function labelAndQuarantine_(messageId, quarantine) {
  try {
    var change = { addLabelIds: [alertLabelId_()], removeLabelIds: quarantine ? ['INBOX'] : [] };
    Gmail.Users.Messages.modify(change, 'me', messageId);
  } catch (err) {
    console.warn('could not label the message: ' + err.name);
  }
}

function reportPayload_(r, messageIdHeader) {
  var indicators = r.links
    .filter(function (l) { return l.flags && l.flags.length; })
    .map(function (l) { return l.destination; });
  if (r.sender && r.sender.domain) {
    indicators.unshift('sender-domain:' + r.sender.domain);
  }
  return {
    message_id_header: clean_(messageIdHeader, 256),
    score: r.score,
    verdict: r.verdict,
    engine_version: r.engine_version,
    sender_email: r.sender ? r.sender.email : '',
    indicators: indicators.slice(0, 15).map(function (i) { return clean_(i, 200); }),
    attack_techniques: (r.attack_techniques || []).map(function (t) { return t.id; }).slice(0, 20),
    user_note: ''
  };
}

/**
 * The alert goes to the user's own address. Everything in it that came from the email is
 * escaped, and it contains no link from the dangerous email - only a link that opens the email
 * in Gmail, where MailGuard's side panel explains it.
 */
function sendAlertEmail_(messageId, r, subject, settings) {
  var me = Session.getActiveUser().getEmail();
  if (!isPlainEmail_(me)) {
    return;
  }
  var rtl = MG_LOCALE_ === 'he';
  var open = 'https://mail.google.com/mail/u/0/#all/' + encodeURIComponent(messageId);
  var sender = r.sender ? esc_(r.sender.email, 120) : t_('sender.unknown');
  var reasons = (r.findings || []).slice(0, 4).map(function (f) {
    return '<li><b>' + esc_(f.title, 120) + '</b> <span style="color:#5f6368">(+' + f.points + ')</span></li>';
  }).join('');
  var recs = (r.recommendations || []).slice(0, 4).map(function (x) { return '<li>' + esc_(x, 300) + '</li>'; }).join('');
  var body =
    '<div dir="' + (rtl ? 'rtl' : 'ltr') + '" style="font-family:Arial,sans-serif;font-size:14px;max-width:620px">' +
    '<div style="background:#d93025;color:#fff;padding:12px 16px;border-radius:8px;font-weight:bold">' +
    t_('banner.malicious') + '</div>' +
    '<p style="font-size:16px"><b>' + t_('alert.intro') + '</b></p>' +
    '<table style="border-collapse:collapse">' +
    '<tr><td style="padding:2px 8px;color:#5f6368">' + t_('alert.from') + '</td><td>' + sender + '</td></tr>' +
    '<tr><td style="padding:2px 8px;color:#5f6368">' + t_('subject') + '</td><td>' + esc_(subject, 160) + '</td></tr>' +
    '<tr><td style="padding:2px 8px;color:#5f6368">' + t_('alert.score') + '</td><td><b style="color:#d93025">' +
    r.score + '/100 · ' + verdictLabel_(r.verdict) + '</b></td></tr></table>' +
    (r.headline ? '<p><b>' + t_('banner.main_threat') + '</b> ' + esc_(r.headline, 300) + '</p>' : '') +
    '<p><b>' + t_('alert.why') + '</b></p><ul>' + reasons + '</ul>' +
    '<p><b>' + t_('section.recommendations') + '</b></p><ul>' + recs + '</ul>' +
    '<p>' + t_(settings.quarantine ? 'alert.done_quarantine' : 'alert.done_label', { label: esc_(ALERT_LABEL_, 60) }) +
    (r.reported_as ? ' ' + t_('alert.done_report', { ref: esc_(r.reported_as, 20) }) : '') + '</p>' +
    '<p><a href="' + open + '" style="background:#1a73e8;color:#fff;padding:8px 14px;border-radius:6px;' +
    'text-decoration:none">' + t_('alert.open') + '</a></p>' +
    '<p style="color:#5f6368;font-size:12px">' + t_('alert.footer') + '</p></div>';
  MailApp.sendEmail({
    to: me,
    subject: '⛔ ' + ALERT_SUBJECT_TAG_ + ': ' + clean_(subject || '', 80) + ' (' + r.score + '/100)',
    htmlBody: body,
    body: t_('alert.intro') + '\n' + clean_(subject, 160) + '\n' + r.score + '/100\n' + open,
    name: 'MailGuard'
  });
}

// ----------------------------------------------------------------------------- never alert twice

function alertedList_() {
  try {
    var v = JSON.parse(PropertiesService.getUserProperties().getProperty('mg:alerts:done') || '[]');
    return Array.isArray(v) ? v : [];
  } catch (err) {
    return [];
  }
}

function alreadyAlerted_(messageId) {
  return alertedList_().indexOf(saltedHash_('a:' + messageId, 16)) !== -1;
}

function rememberAlerted_(messageId) {
  var list = alertedList_().concat([saltedHash_('a:' + messageId, 16)]).slice(-ALERT_MAX_REMEMBERED_);
  PropertiesService.getUserProperties().setProperty('mg:alerts:done', JSON.stringify(list));
}

// ===================================================================== Api.gs

/**
 * Signed calls to the backend.
 *
 * Signature: HMAC-SHA256(secret, timestamp + "." + nonce + "." + client + "." + body)
 *  - timestamp + nonce: the backend rejects stale or replayed requests;
 *  - client: a pseudonymous per-user id (HMAC of the user's address) used only for
 *    rate limiting, so the backend never learns who the user is.
 */

function BackendError_(kind, status, detail) {
  this.name = 'BackendError';
  this.kind = kind; // auth | rate | busy | too_large | invalid | server | network | bad_response | untrusted
  this.status = status || 0;
  // Short technical reason shown in the error card, so a setup problem can be diagnosed
  // (e.g. "URL not in urlFetchWhitelist"). Never contains the secret or email content.
  this.detail = clean_(detail || '', 200);
  this.message = 'backend error: ' + kind + (status ? ' (' + status + ')' : '');
}

function clientId_(secret) {
  var email = Session.getActiveUser().getEmail() || 'unknown';
  return hmacHex_('client:' + email.toLowerCase(), secret).slice(0, 32);
}

function callBackend_(payload, config) {
  return validateResult_(signedPost_('/v1/analyze', payload, config));
}

function reportToSecOps_(payload, config) {
  var data = signedPost_('/v1/report', payload, config);
  if (!data || !/^MG-[0-9A-F]{8}$/.test(String(data.report_id))) {
    throw new BackendError_('bad_response', 200);
  }
  return data.report_id;
}

/** POST a JSON payload with an HMAC signature; returns the parsed JSON body. */
function signedPost_(path, payload, config) {
  var body = JSON.stringify(payload);
  var ts = String(Math.floor(Date.now() / 1000));
  var nonce = Utilities.getUuid();
  var client = clientId_(config.secret);
  var signature = hmacHex_(ts + '.' + nonce + '.' + client + '.' + body, config.secret);

  var resp;
  try {
    resp = UrlFetchApp.fetch(config.backendUrl + path, {
      method: 'post',
      contentType: 'application/json; charset=utf-8',
      payload: Utilities.newBlob(body).getBytes(), // exact UTF-8 bytes that were signed
      headers: {
        'X-MG-Timestamp': ts,
        'X-MG-Nonce': nonce,
        'X-MG-Client': client,
        'X-MG-Signature': signature,
        // ngrok's free plan answers "browser-like" clients (Apps Script's user agent counts) with an
        // HTML warning page instead of forwarding the request. This header skips it; elsewhere it's ignored.
        'ngrok-skip-browser-warning': '1'
      },
      muteHttpExceptions: true,
      followRedirects: false,
      validateHttpsCertificates: true
    });
  } catch (err) {
    throw new BackendError_('network', 0, explainFetchError_(err, config.backendUrl));
  }

  var code = resp.getResponseCode();
  if (code === 200) {
    var bytes = resp.getContent();
    var sigProblem = responseSignatureProblem_(resp, bytes, nonce, config.secret);
    if (sigProblem) {
      // Not from our backend (or tampered with in transit): never show its verdict.
      throw new BackendError_('untrusted', code, sigProblem);
    }
    try {
      return JSON.parse(Utilities.newBlob(bytes).getDataAsString('UTF-8'));
    } catch (err) {
      throw new BackendError_('bad_response', code);
    }
  }
  if (code === 403 || code === 404) {
    // 403 from Google's front end: the Cloud Run service does not allow unauthenticated calls.
    throw new BackendError_(code === 403 ? 'forbidden' : 'not_found', code, 'HTTP ' + code + ' from ' + config.backendUrl + path);
  }
  var kinds = { 401: 'auth', 413: 'too_large', 422: 'invalid', 429: 'rate', 503: 'busy' };
  throw new BackendError_(kinds[code] || (code >= 500 ? 'server' : 'invalid'), code);
}

/**
 * Verdict integrity: the backend signs HMAC(secret, "resp." + nonce + "." + body). Binding
 * to this request's fresh nonce means a stale (replayed) "safe" answer is rejected too.
 */
function responseSignatureValid_(resp, bodyBytes, nonce, secret) {
  return !responseSignatureProblem_(resp, bodyBytes, nonce, secret);
}

/** '' when the signature is valid; otherwise a short reason for the error card. */
function responseSignatureProblem_(resp, bodyBytes, nonce, secret) {
  var headers = resp.getHeaders() || {};
  var got = '';
  Object.keys(headers).forEach(function (k) {
    if (String(k).toLowerCase() === 'x-mg-response-signature') {
      got = String(headers[k]).toLowerCase();
    }
  });
  if (!got && bodyBytes.length && (bodyBytes[0] === 60 || /html/i.test(String(headerOf_(resp, 'content-type'))))) {
    return 'got a web page instead of MailGuard\'s answer - a tunnel or proxy (e.g. the ngrok warning page) ' +
      'is in the way, or BACKEND_URL points to the wrong server';
  }
  if (!got) {
    return 'the answer has no signature: the backend has no MG_HMAC_SECRET (development mode) or is an older ' +
      'version - redeploy it from this package';
  }
  if (!/^[0-9a-f]{64}$/.test(got)) {
    return 'malformed response signature';
  }
  var message = Utilities.newBlob('resp.' + nonce + '.').getBytes().concat(bodyBytes);
  var expected = bytesToHex_(Utilities.computeHmacSha256Signature(message, Utilities.newBlob(secret).getBytes()));
  return constantTimeEquals_(expected, got) ? '' : 'response signed with a different secret, or changed in transit';
}

function constantTimeEquals_(a, b) {
  if (a.length !== b.length) {
    return false;
  }
  var diff = 0;
  for (var i = 0; i < a.length; i++) {
    diff |= a.charCodeAt(i) ^ b.charCodeAt(i);
  }
  return diff === 0;
}

/**
 * Never trust the response shape either. Beyond types, every list and string is bounded,
 * so even a buggy or compromised backend cannot build a giant or malformed card.
 * Applied to cached results as well.
 */
function validateResult_(d) {
  var verdicts = ['safe', 'suspicious', 'malicious'];
  var str = function (v, max) { return typeof v === 'string' && v.length <= max; };
  var list = function (v, max) { return Array.isArray(v) && v.length <= max; };
  var technique;
  var link;
  var finding = function (f) {
    return f && str(f.id, 64) && str(f.category, 80) && str(f.title, 200) && str(f.detail, 2000) &&
      typeof f.points === 'number' && isFinite(f.points) &&
      list(f.evidence || [], 10) && (f.evidence || []).every(function (e) { return str(e, 400); }) &&
      list(f.attack || [], 10) && (f.attack || []).every(function (a) { return technique(a); });
  };
  technique = function (a) {
    return a && /^(T\d{4}(\.\d{3})?|AML\.T\d{4}(\.\d{3})?)$/.test(a.id) && str(a.name, 120) && str(a.framework, 10);
  };
  link = function (l) {
    return l && str(l.text, 200) && str(l.destination, 300) && str(l.domain, 300) &&
      list(l.flags, 20) && l.flags.every(function (x) { return str(x, 60); });
  };
  var ok = d && typeof d.score === 'number' && d.score >= 0 && d.score <= 100 &&
    verdicts.indexOf(d.verdict) !== -1 &&
    str(d.headline, 400) && str(d.summary, 1000) &&
    (d.subject === undefined || str(d.subject, 300)) &&
    (d.language === undefined || (typeof d.language === 'string' && /^[a-z]{0,3}$/.test(d.language))) &&
    list(d.findings, 60) && d.findings.every(finding) &&
    list(d.mitigations, 20) && d.mitigations.every(finding) &&
    list(d.exposures || [], 20) && (d.exposures || []).every(finding) &&
    list(d.attack_techniques || [], 30) && (d.attack_techniques || []).every(technique) &&
    list(d.recommendations, 15) && d.recommendations.every(function (r) { return str(r, 500); }) &&
    list(d.links, 20) && d.links.every(link) &&
    typeof d.coverage === 'object' && d.coverage !== null && Object.keys(d.coverage).length <= 20 &&
    Object.keys(d.coverage).every(function (k) { return str(k, 80) && str(d.coverage[k], 160); }) &&
    typeof d.analysis_ms === 'number' && isFinite(d.analysis_ms) && d.analysis_ms >= 0 &&
    (d.sender === null || (typeof d.sender === 'object' && str(d.sender.email, 320)));
  if (!ok) {
    throw new BackendError_('bad_response', 200);
  }
  return d;
}

/** Turns Apps Script's fetch exceptions into a hint about what to fix. */
function explainFetchError_(err, backendUrl) {
  var msg = String((err && err.message) || err || '');
  var hint;
  if (/whitelist|allowlist|urlFetchWhitelist|not allowed/i.test(msg)) {
    hint = 'URL is not in urlFetchWhitelist in appsscript.json';
  } else if (/permission|authori[sz]/i.test(msg)) {
    hint = 'missing permission - run diagnose() once from the script editor to re-authorise';
  } else if (/DNS|Address unavailable|resolve|unknown host/i.test(msg)) {
    hint = 'host not found - check BACKEND_URL';
  } else if (/timed? ?out|timeout/i.test(msg)) {
    hint = 'the backend did not answer in time';
  } else {
    hint = 'request failed';
  }
  return hint + ' (' + backendUrl + '): ' + msg.slice(0, 120);
}

function headerOf_(resp, name) {
  var headers = resp.getHeaders() || {};
  var key = Object.keys(headers).filter(function (k) { return String(k).toLowerCase() === name; })[0];
  return key ? headers[key] : '';
}

// ===================================================================== Cards.gs

/**
 * Card UI. Design goals:
 *  - the verdict is readable in one second: a hazard banner, a traffic-light gauge, a number;
 *  - the single most important threat is named concretely, right under the banner;
 *  - every point of the score is traceable to a plain-language, specific reason;
 *  - the user can act immediately (Trash, Block, Report), with safe defaults;
 *  - nothing from the email is ever clickable here (links are shown de-fanged).
 */

var VERDICT_LIGHT_ = { safe: '🟢', suspicious: '🟠', malicious: '🔴' };
var VERDICT_ICON_ = { safe: 'verified_user', suspicious: 'warning', malicious: 'report' };
function verdictLabel_(v) {
  return t_('verdict.' + v);
}
var CATEGORY_ICON_ = {
  'Sender authentication': ['verified_user', 'EMAIL'],
  'Sender identity': ['person', 'PERSON'],
  'Subject line': ['subject', 'EMAIL'],
  'Images & emojis': ['image', 'DESCRIPTION'],
  'Links': ['link', 'BOOKMARK'],
  'Attachments': ['attach_file', 'DESCRIPTION'],
  'Message content': ['chat', 'DESCRIPTION'],
  'Social engineering pattern': ['psychology', 'DESCRIPTION'],
  'Your history with the sender': ['history', 'CLOCK'],
  'Threat intelligence': ['public', 'STAR'],
  'Cloud & identity attacks': ['cloud', 'STAR'],
  'Hidden content & AI manipulation': ['visibility_off', 'DESCRIPTION'],
  'Sensitive data exposure': ['vpn_key', 'MEMBERSHIP']
};

/**
 * Icons as image URLs from Google's Material icon set. (setMaterialIcon is not rendered by
 * Gmail add-ons - it shows the icon's *name* as text - so it is not used.)
 */
function icon_(materialName, knownIconName) {
  var url = 'https://www.gstatic.com/images/icons/material/system/2x/' + materialName + '_black_48dp.png';
  try {
    return CardService.newIconImage().setIconUrl(url).setAltText(materialName);
  } catch (err) {
    return CardService.newIconImage().setIcon(CardService.Icon[knownIconName] || CardService.Icon.DESCRIPTION);
  }
}

/** Collapse a section, keeping the first n widgets visible. */
function collapsible_(section, visible) {
  section.setCollapsible(true);
  if (visible > 0) {
    section.setNumUncollapsibleWidgets(visible);
  }
  return section;
}

function headerImage_(name) {
  return 'https://www.gstatic.com/images/icons/material/system/2x/' + name + '_black_48dp.png';
}

function action_(fn, messageId) {
  var a = CardService.newAction().setFunctionName(fn);
  return messageId ? a.setParameters({ messageId: String(messageId) }) : a;
}

function button_(text, fn, messageId, color) {
  var b = CardService.newTextButton().setText(text).setOnClickAction(action_(fn, messageId));
  if (color) {
    b.setTextButtonStyle(CardService.TextButtonStyle.FILLED).setBackgroundColor(color);
  }
  return b;
}

// ----------------------------------------------------------------------------- building blocks

/** Traffic-light gauge, e.g. [█████████░] 92/100 🔴 */
function gauge_(score, verdict) {
  var filled = Math.max(0, Math.min(10, Math.round(score / 10)));
  return '<font color="' + MG.COLORS[verdict] + '">[' + new Array(filled + 1).join('█') +
    new Array(10 - filled + 1).join('░') + ']</font>  <b>' + score + '</b>/100  ' + VERDICT_LIGHT_[verdict];
}

/**
 * The banner is the first thing on the card. It follows the engine's verdict rather than a
 * separate threshold, so banner, gauge colour and score never disagree.
 * The safe state deliberately says "No threats detected", not "Verified": a scanner can
 * only report the absence of evidence, and overstating safety is how users get phished.
 */
function bannerSection_(r) {
  var text;
  if (r.verdict === 'malicious') {
    text = '<font color="' + MG.COLORS.malicious + '"><b>' + t_('banner.malicious') + '</b></font>';
  } else if (r.verdict === 'suspicious') {
    text = '<font color="' + MG.COLORS.suspicious + '"><b>' + t_('banner.suspicious') + '</b></font>';
  } else {
    text = '<font color="' + MG.COLORS.safe + '"><b>' + t_('banner.safe') + '</b></font><br>' +
      '<font color="' + MG.COLORS.muted + '">' +
      t_(r.confidence === 'high' ? 'banner.safe_note' : 'banner.safe_note_partial') + '</font>';
  }
  if (r.headline) {
    text += '<br><br><b>' + t_('banner.main_threat') + '</b> ' + esc_(r.headline, 300);
  }
  if (r.reported_as) {
    text += '<br><br><font color="' + MG.COLORS.muted + '">' + t_('banner.reported', { ref: esc_(r.reported_as, 20) }) +
      '</font>';
  }
  // The subject is attacker-written: shown escaped, so the user can match the verdict to the email.
  if (r.subject) {
    text += '<br><br><font color="' + MG.COLORS.muted + '">' + t_('subject') + '</font> ' + esc_(r.subject, 160);
  }
  if (r.language && languageName_(r.language)) {
    text += '<br><font color="' + MG.COLORS.muted + '">' + t_('language', { lang: languageName_(r.language) }) + '</font>';
  }
  return CardService.newCardSection().addWidget(CardService.newTextParagraph().setText(text));
}

function gaugeSection_(r) {
  return CardService.newCardSection()
    .addWidget(CardService.newDecoratedText()
      .setTopLabel(t_('gauge.label', { verdict: verdictLabel_(r.verdict) }))
      .setText(gauge_(r.score, r.verdict))
      .setBottomLabel(t_('confidence.' + r.confidence))
      .setWrapText(true))
    .addWidget(CardService.newTextParagraph().setText(esc_(r.summary, 600)));
}

function findingWidget_(f, isMitigation) {
  var cat = CATEGORY_ICON_[f.category] || ['info', 'DESCRIPTION'];
  var points = isMitigation ? '−' + Math.abs(f.points) : '+' + f.points;
  var text = '<b>' + esc_(f.title, 120) + '</b><br>' + esc_(f.detail, 500);
  (f.evidence || []).slice(0, 3).forEach(function (ev) {
    text += '<br><font color="' + MG.COLORS.muted + '">▸ ' + esc_(ev, 140) + '</font>';
  });
  var attack = (f.attack || [])[0];
  return CardService.newDecoratedText()
    .setTopLabel(label_(categoryLabel_(f.category), 60) + '  ·  ' + points + (attack ? '  ·  ' + label_(attack.id, 16) : ''))
    .setText(text)
    .setWrapText(true)
    .setStartIcon(icon_(cat[0], cat[1]));
}

function exposureWidget_(f) {
  var text = '<b>' + esc_(f.title, 120) + '</b><br>' + esc_(f.detail, 500);
  (f.evidence || []).slice(0, 3).forEach(function (ev) {
    text += '<br><font color="' + MG.COLORS.muted + '">▸ ' + esc_(ev, 80) + '</font>';
  });
  return CardService.newDecoratedText()
    .setTopLabel(t_('exposure.label'))
    .setText(text)
    .setWrapText(true)
    .setStartIcon(icon_('vpn_key', 'MEMBERSHIP'));
}

/** MITRE ATT&CK / ATLAS techniques seen in this email - the analyst's vocabulary. */
function attackSection_(r) {
  var refs = (r.attack_techniques || []).slice(0, 12);
  if (!refs.length || r.verdict === 'safe') {
    return null;
  }
  var lines = refs.map(function (t) {
    return '<b>' + esc_(t.id, 16) + '</b>  ' + esc_(t.name, 120) +
      (t.framework === 'ATLAS' ? ' <font color="' + MG.COLORS.muted + '">(MITRE ATLAS)</font>' : '');
  });
  return collapsible_(CardService.newCardSection().setHeader('MITRE ATT&CK (' + refs.length + ')'), 0)
    .addWidget(CardService.newTextParagraph().setText(lines.join('<br>')));
}

function senderLine_(sender) {
  if (!sender) {
    return t_('sender.unknown');
  }
  var status = t_(sender.authenticated ? 'sender.authenticated' : sender.spoofed ? 'sender.spoofed' : 'sender.unverified');
  return t_('sender.line', { email: esc_(sender.email, 120), status: status });
}

/** Response actions. What is offered depends on the verdict and on whether the sender is real. */
function actionsSection_(r, messageId) {
  var section = CardService.newCardSection().setHeader(t_('section.actions'));
  section.addWidget(CardService.newTextParagraph().setText(senderLine_(r.sender)));
  var buttons = CardService.newButtonSet();
  if (r.verdict === 'safe') {
    buttons.addButton(button_(t_('btn.report_safe'), 'onReportSecOps', messageId));
  } else {
    var danger = r.verdict === 'malicious' ? MG.COLORS.malicious : null;
    buttons.addButton(button_(t_('btn.trash'), 'onTrashMessage', messageId, danger));
    if (r.sender) {
      buttons.addButton(button_(t_('btn.block'), 'onConfirmBlock', messageId));
    }
    if (!r.reported_as) {
      buttons.addButton(button_(t_('btn.report'), 'onReportSecOps', messageId));
    }
  }
  return section.addWidget(buttons);
}

function performanceLine_(r, meta) {
  var engine = (r.analysis_ms / 1000).toFixed(2) + ' s';
  if (meta && meta.cached) {
    return t_('perf.cached', { engine: engine });
  }
  var total = typeof r.client_ms === 'number' ? (r.client_ms / 1000).toFixed(2) + ' s' : engine;
  return t_('perf.fresh', { total: total, engine: engine });
}

// ----------------------------------------------------------------------------- result card

function buildResultCard_(r, meta) {
  var messageId = meta && meta.messageId;
  var card = CardService.newCardBuilder()
    .setName('result')
    .setHeader(CardService.newCardHeader()
      .setTitle('MailGuard')
      .setSubtitle(VERDICT_LIGHT_[r.verdict] + ' ' + verdictLabel_(r.verdict) + '  ·  ' + r.score + '/100')
      .setImageUrl(headerImage_(VERDICT_ICON_[r.verdict]))
      .setImageStyle(CardService.ImageStyle.SQUARE));

  // 1. Hazard banner + the concrete main threat, then the gauge.
  card.addSection(bannerSection_(r));
  card.addSection(gaugeSection_(r));

  // 2. Secrets exposed in the email: a separate concern from maliciousness.
  if ((r.exposures || []).length) {
    var exp = CardService.newCardSection().setHeader(t_('section.exposures', { n: r.exposures.length }));
    r.exposures.forEach(function (f) { exp.addWidget(exposureWidget_(f)); });
    card.addSection(exp);
  }

  // 3. Specific threats, strongest first. The top three are always visible.
  if (r.findings.length) {
    var why = CardService.newCardSection()
      .setHeader(t_(r.verdict === 'safe' ? 'section.notes' : 'section.findings', { n: r.findings.length }));
    r.findings.forEach(function (f) { why.addWidget(findingWidget_(f, false)); });
    if (r.findings.length > 3) {
      collapsible_(why, 3);
    }
    card.addSection(why);
  }

  // 3. What to do, then the buttons to do it.
  if (r.recommendations.length) {
    card.addSection(CardService.newCardSection().setHeader(t_('section.recommendations'))
      .addWidget(CardService.newTextParagraph().setText(
        r.recommendations.map(function (t) { return '• ' + esc_(t, 300); }).join('<br>'))));
  }
  if (messageId && actionsEnabled_()) {
    card.addSection(actionsSection_(r, messageId));
  }

  // 4. Supporting detail, collapsed.
  if (r.mitigations.length) {
    var good = collapsible_(CardService.newCardSection().setHeader(t_('section.mitigations')), r.findings.length ? 0 : 1);
    r.mitigations.forEach(function (f) { good.addWidget(findingWidget_(f, true)); });
    card.addSection(good);
  }
  if (r.links.length) {
    var flagged = r.links.filter(function (l) { return l.flags && l.flags.length; }).length;
    var links = collapsible_(CardService.newCardSection()
      .setHeader(t_('section.links', { n: r.links.length })), Math.min(flagged, 2));
    r.links.forEach(function (l) {
      var w = CardService.newDecoratedText()
        .setText(esc_(l.destination, 120))
        .setWrapText(true)
        .setBottomLabel(l.flags && l.flags.length ? '⚠ ' + label_(l.flags.join(', '), 120) : t_('link.ok'))
        .setStartIcon(icon_(l.flags && l.flags.length ? 'link_off' : 'link', 'BOOKMARK'));
      if (l.text) {
        w.setTopLabel(t_('link.shown_as', { text: label_(l.text, 60) }));
      }
      links.addWidget(w);
    });
    card.addSection(links);
  }

  var attack = attackSection_(r);
  if (attack) {
    card.addSection(attack);
  }

  // 5. Coverage and performance: say plainly what was checked and how long it took.
  var coverage = collapsible_(CardService.newCardSection().setHeader(t_('section.coverage')), 1);
  coverage.addWidget(CardService.newTextParagraph().setText(
    '<font color="' + MG.COLORS.muted + '">' + esc_(performanceLine_(r, meta), 120) + '</font>'));
  var lines = Object.keys(r.coverage).map(function (k) {
    return '<b>' + esc_(k, 60) + '</b>: ' + esc_(r.coverage[k], 80);
  });
  lines.push('<font color="' + MG.COLORS.muted + '">' + t_('engine', { v: esc_(r.engine_version, 20) }) + '</font>');
  coverage.addWidget(CardService.newTextParagraph().setText(lines.join('<br>')));
  card.addSection(coverage);

  card.setFixedFooter(CardService.newFixedFooter()
    .setPrimaryButton(CardService.newTextButton().setText(t_('btn.rescan')).setOnClickAction(action_('onRescan', messageId)))
    .setSecondaryButton(CardService.newTextButton().setText(t_('btn.methodology'))
      .setOnClickAction(action_('onShowMethodology'))));
  return card.build();
}

// ----------------------------------------------------------------------------- action cards

function buildBlockConfirmCard_(messageId, sender, identity) {
  var spoofed = identity && identity.spoofed;
  var unverified = !identity || (!identity.authenticated && !identity.spoofed);
  var who = esc_(sender, 120);
  var text = t_('block.body', { sender: who });
  if (spoofed) {
    text = '<font color="' + MG.COLORS.malicious + '">' + t_('block.spoofed') + '</font><br>' +
      t_('block.spoofed_more', { sender: who }) + '<br><br>' + text;
  } else if (unverified) {
    text = '<font color="' + MG.COLORS.suspicious + '">' + t_('block.unverified') + '</font> ' +
      t_('block.unverified_more') + '<br><br>' + text;
  }
  var footer = CardService.newFixedFooter();
  if (spoofed) {
    footer.setPrimaryButton(button_(t_('btn.report_instead'), 'onReportSecOps', messageId))
      .setSecondaryButton(button_(t_('btn.block_anyway'), 'onBlockSender', messageId));
  } else {
    footer.setPrimaryButton(button_(t_('btn.block'), 'onBlockSender', messageId, MG.COLORS.malicious))
      .setSecondaryButton(CardService.newTextButton().setText(t_('btn.cancel')).setOnClickAction(action_('onCancel')));
  }
  return CardService.newCardBuilder()
    .setName('confirm-block')
    .setHeader(CardService.newCardHeader().setTitle(t_('block.title')))
    .addSection(CardService.newCardSection().addWidget(CardService.newTextParagraph().setText(text)))
    .setFixedFooter(footer)
    .build();
}

function buildTrashedCard_(messageId) {
  return CardService.newCardBuilder()
    .setName('trashed')
    .setHeader(CardService.newCardHeader().setTitle('MailGuard').setSubtitle(t_('trashed.subtitle'))
      .setImageUrl(headerImage_('delete')))
    .addSection(CardService.newCardSection()
      .addWidget(CardService.newTextParagraph().setText(t_('trashed.body')))
      .addWidget(CardService.newButtonSet()
        .addButton(button_(t_('btn.undo'), 'onUndoTrash', messageId))
        .addButton(button_(t_('btn.report'), 'onReportSecOps', messageId))))
    .build();
}

// ----------------------------------------------------------------------------- other cards

function buildHomepageCard_() {
  return CardService.newCardBuilder()
    .setHeader(CardService.newCardHeader().setTitle('MailGuard').setSubtitle(t_('home.subtitle'))
      .setImageUrl(headerImage_('security')))
    .addSection(CardService.newCardSection()
      .addWidget(CardService.newTextParagraph().setText(
        t_('home.intro') + '<br><br><b>' + t_('home.checks_title') + '</b><br>• ' + t_('home.checks'))))
    .addSection(alertsSection_())
    .addSection(CardService.newCardSection().setHeader(t_('home.privacy_title'))
      .addWidget(CardService.newTextParagraph().setText(t_('home.privacy'))))
    .build();
}

/** On/off switch for background alerts (Alerts.gs). */
function alertsSection_() {
  var on = false;
  try {
    on = alertsEnabled_();
  } catch (err) {
    // trigger state unavailable (e.g. scope not granted yet): show as off
  }
  return CardService.newCardSection().setHeader(t_('alerts.title'))
    .addWidget(CardService.newTextParagraph().setText(
      on ? t_('alerts.on', { min: alertSettings_().minScore }) : t_('alerts.off')))
    .addWidget(CardService.newButtonSet().addButton(
      button_(t_(on ? 'alerts.btn_off' : 'alerts.btn_on'), 'onToggleAlerts', null, on ? null : MG.COLORS.safe)));
}

function buildMethodologyCard_() {
  return CardService.newCardBuilder()
    .setHeader(CardService.newCardHeader().setTitle(t_('method.title')))
    .addSection(CardService.newCardSection().addWidget(CardService.newTextParagraph().setText(t_('method.body'))))
    .build();
}

function buildErrorCard_(err) {
  var reason;
  if (err instanceof ConfigError_) {
    reason = t_('error.config', { msg: esc_(err.message) });
  } else if (err instanceof BackendError_) {
    var known = ['auth', 'rate', 'busy', 'untrusted', 'too_large', 'invalid', 'server', 'network', 'bad_response',
      'forbidden', 'not_found'];
    reason = known.indexOf(err.kind) !== -1 ? t_('error.' + err.kind) : t_('error.unexpected');
    if (err.detail) {
      reason += '<br><br><font color="' + MG.COLORS.muted + '">' + t_('error.details') + ' ' + esc_(err.detail, 200) +
        '</font>';
    }
  } else {
    reason = t_('error.reading');
  }
  return CardService.newCardBuilder()
    .setHeader(CardService.newCardHeader().setTitle('MailGuard').setSubtitle(t_('error.subtitle'))
      .setImageUrl(headerImage_('error_outline')))
    .addSection(CardService.newCardSection()
      .addWidget(CardService.newTextParagraph().setText(reason))
      .addWidget(CardService.newTextParagraph().setText(t_('error.not_safe'))))
    .setFixedFooter(CardService.newFixedFooter().setPrimaryButton(
      CardService.newTextButton().setText(t_('btn.retry')).setOnClickAction(action_('onRescan'))))
    .build();
}

// ===================================================================== Code.gs

/**
 * MailGuard - Gmail add-on entry points.
 *
 * Flow: message opened -> extract (Extract.gs, History.gs) -> signed POST to the
 * backend (Api.gs) -> render the explanation (Cards.gs). Results are cached per user
 * for a few minutes so re-opening an email is instant and doesn't spend intel quota.
 */

function onHomepage(e) {
  setLocale_(e);
  return buildHomepageCard_();
}

function onGmailMessageOpen(e) {
  setLocale_(e);
  return analyzeAndRender_(e, false);
}

/** "Re-scan" button: bypass the cache and replace the current card. */
function onRescan(e) {
  setLocale_(e);
  var card = analyzeAndRender_(e, true);
  return CardService.newActionResponseBuilder()
    .setNavigation(CardService.newNavigation().updateCard(card))
    .build();
}

/** "How the score works" button. */
function onShowMethodology(e) {
  setLocale_(e);
  return CardService.newActionResponseBuilder()
    .setNavigation(CardService.newNavigation().pushCard(buildMethodologyCard_()))
    .build();
}

function analyzeAndRender_(e, forceRescan) {
  var messageId = (e && e.gmail && e.gmail.messageId) || (e && e.parameters && e.parameters.messageId);
  if (!messageId) {
    return buildHomepageCard_();
  }
  try {
    if (!forceRescan) {
      var hit = cachedResult_(messageId);
      if (hit) {
        return buildResultCard_(hit, { cached: true, messageId: messageId });
      }
    }
    var result = analyzeMessage_(e, messageId);
    return buildResultCard_(result, { cached: false, messageId: messageId });
  } catch (err) {
    // Log the error *type* only - never message content.
    console.error('analysis failed: ' + (err && err.name) + ' ' + (err && err.kind ? err.kind : ''));
    return buildErrorCard_(err);
  }
}

/** Extract, sign, send, validate - and record the end-to-end time the user waited. */
function analyzeMessage_(e, messageId) {
  var started = Date.now();
  var config = getConfig_();
  GmailApp.setCurrentMessageAccessToken(e.gmail.accessToken);
  var message = GmailApp.getMessageById(messageId);
  var payload = buildPayload_(message, messageId, config);
  var result = callBackend_(payload, config);
  result.client_ms = Date.now() - started; // includes extraction and network, not just the engine
  cacheResult_(messageId, result);
  // Remember the verdict for next time (salted hashes only; see History.gs) - but only when the
  // From address is authenticated. Otherwise anyone could forge mail "from" your colleague, get it
  // rated malicious, and poison the colleague's record for their genuine mail.
  var fromEmail = emailFromHeader_(message.getFrom());
  if (config.senderHistory && result.sender && result.sender.authenticated && result.sender.email === fromEmail) {
    recordVerdict_(fromEmail, messageId, result.verdict);
  }
  return result;
}

/** The language is part of the key: the backend writes explanations in the user's language. */
function cacheKey_(messageId) {
  return 'mg:' + MG.VERSION + ':' + MG_LOCALE_ + ':' + messageId;
}

function cachedResult_(messageId) {
  try {
    var hit = CacheService.getUserCache().get(cacheKey_(messageId)); // per-user, never shared
    return hit ? validateResult_(JSON.parse(hit)) : null; // re-validated: the cache is not a trust boundary
  } catch (err) {
    return null;
  }
}

/** Best effort: a cache failure must never turn a good result into an error card. */
function cacheResult_(messageId, result) {
  try {
    var serialized = JSON.stringify(result);
    if (Utilities.newBlob(serialized).getBytes().length < 95000) { // CacheService limit: 100 KB
      CacheService.getUserCache().put(cacheKey_(messageId), serialized, MG.CACHE_TTL_SECONDS);
    }
  } catch (err) {
    console.warn('result not cached: ' + err.name);
  }
}

// ===================================================================== Config.gs

/**
 * Configuration and limits.
 *
 * Secrets live in Script Properties (Project Settings -> Script properties), never in
 * source. They are readable by people who can edit this script project, not by the
 * users who install the add-on.
 *   BACKEND_URL            https://<your-service>.run.app
 *   HMAC_SECRET            same value as the backend's MG_HMAC_SECRET (>= 32 chars)
 *   ENABLE_SENDER_HISTORY  "false" to skip the mailbox-history lookup and verdict memory (optional)
 *   ENABLE_ACTIONS         "false" to hide Trash / Block / Report buttons (optional)
 *   ALERT_MIN_SCORE, ALERT_QUARANTINE, ALERT_AUTO_REPORT, ALERT_INTERVAL_MIN
 *                          background alerts, see Alerts.gs (optional)
 */

var MG = Object.freeze({
  VERSION: '1.4.4',
  MAX_HEADER_CHARS: 128 * 1024,
  MAX_TEXT_CHARS: 200000,
  MAX_HTML_CHARS: 600000,
  MAX_ATTACHMENTS: 25,
  // Contents are sent only for small, statically inspectable types; everything else
  // is represented by name, type, size and SHA-256 hash.
  MAX_INSPECT_BYTES: 2 * 1024 * 1024,
  MAX_INSPECT_TOTAL_BYTES: 6 * 1024 * 1024, // ~8 MB as base64: stays under the backend's 12 MB cap
  INSPECTABLE_EXT: ['doc', 'docx', 'docm', 'dotm', 'xls', 'xlsx', 'xlsm', 'xlsb', 'ppt', 'pptx', 'pptm',
                    'pdf', 'zip', 'rtf', 'jpg', 'jpeg', 'png', 'txt'],
  HISTORY_LOOKBACK: 50,
  HISTORY_MAX_RECORDS: 400, // salted-hash verdict records kept in UserProperties (~100 KB of the 500 KB quota)
  HISTORY_MAX_PER_SENDER: 10,
  CACHE_TTL_SECONDS: 600,
  COLORS: { safe: '#188038', suspicious: '#e37400', malicious: '#d93025', muted: '#5f6368' }
});

/** Thrown for problems the person installing the add-on must fix (not the end user). */
function ConfigError_(message) {
  this.name = 'ConfigError';
  this.message = message;
}

function getConfig_() {
  var props = PropertiesService.getScriptProperties();
  var backendUrl = String(props.getProperty('BACKEND_URL') || '').replace(/\/+$/, '');
  var secret = String(props.getProperty('HMAC_SECRET') || '').trim(); // a pasted space or newline breaks signing
  if (!/^https:\/\/[a-z0-9.-]+(:\d+)?$/i.test(backendUrl)) {
    throw new ConfigError_('BACKEND_URL is missing or is not an https:// origin.');
  }
  if (secret.length < 32) {
    throw new ConfigError_('HMAC_SECRET is missing or shorter than 32 characters.');
  }
  return {
    backendUrl: backendUrl,
    secret: secret,
    senderHistory: props.getProperty('ENABLE_SENDER_HISTORY') !== 'false',
    actions: props.getProperty('ENABLE_ACTIONS') !== 'false'
  };
}

/** Feature flags readable without a valid backend configuration (used by the UI). */
function actionsEnabled_() {
  return PropertiesService.getScriptProperties().getProperty('ENABLE_ACTIONS') !== 'false';
}

// ===================================================================== Diagnose.gs

/**
 * Setup self-check. In the Apps Script editor choose "diagnose" in the function list and press
 * Run, then read the Execution log. It checks, in order, everything the side panel needs and
 * says exactly what to fix. Running it also (re)grants the add-on's permissions.
 * It never prints the shared secret.
 */
function diagnose() {
  var ok = true;
  var say = function (good, en, he) {
    ok = ok && good;
    console.log((good ? '✅ ' : '❌ ') + en + '\n   ' + he);
  };
  var props = PropertiesService.getScriptProperties();
  var url = String(props.getProperty('BACKEND_URL') || '');
  var secret = String(props.getProperty('HMAC_SECRET') || '').trim();

  // 1. Script properties
  var urlOk = /^https:\/\/[a-z0-9.-]+(:\d+)?$/i.test(url);
  say(urlOk, 'BACKEND_URL = "' + url + '"' + (urlOk ? '' : ' - must be https://host with no path and no trailing slash'),
    urlOk ? 'כתובת השרת מוגדרת' : 'כתובת השרת חסרה או שגויה: צריכה להיות https://... בלי / בסוף');
  say(secret.length >= 32, 'HMAC_SECRET length ' + secret.length + (secret.length >= 32 ? '' : ' - must be the 64-char value from Secret Manager'),
    secret.length >= 32 ? 'הסוד המשותף מוגדר' : 'הסוד המשותף חסר או קצר מדי - העתיקי אותו מ-gcloud secrets');
  if (!urlOk) {
    return finishDiagnose_(false);
  }

  // 2. Reachability (also proves urlFetchWhitelist and the external_request permission)
  var health;
  try {
    health = UrlFetchApp.fetch(url + '/healthz', {
      muteHttpExceptions: true, followRedirects: false, headers: { 'ngrok-skip-browser-warning': '1' }
    });
  } catch (err) {
    var why = explainFetchError_(err, url);
    say(false, 'Cannot reach ' + url + '/healthz: ' + why,
      /whitelist/.test(why)
        ? 'הכתובת לא מופיעה ב-urlFetchWhitelist בקובץ appsscript.json. כתבי שם בדיוק: "' + url + '/" (עם / בסוף)'
        : 'אין גישה לשרת. בדקי שהכתובת נכונה ושהשירות פרוס (פתחי את ' + url + '/healthz בדפדפן)');
    return finishDiagnose_(false);
  }
  var code = health.getResponseCode();
  say(code === 200, 'GET /healthz -> HTTP ' + code + ' ' + health.getContentText().slice(0, 80),
    code === 200 ? 'השרת זמין' : code === 403
      ? 'השרת חוסם (403): צריך לאפשר גישה ללא אימות - הריצי שוב את deploy_backend.sh או: gcloud run services add-iam-policy-binding mailguard --member=allUsers --role=roles/run.invoker'
      : 'השרת החזיר שגיאה - בדקי ב-Cloud Run ← Logs');
  if (code !== 200 || secret.length < 32) {
    return finishDiagnose_(false);
  }
  var info = {};
  try {
    info = JSON.parse(health.getContentText()) || {};
  } catch (err) {
    say(false, 'GET /healthz returned a web page, not MailGuard: ' + health.getContentText().slice(0, 60),
      'במקום השרת חזר דף אינטרנט - כנראה דף האזהרה של ngrok, או שהכתובת מצביעה למקום אחר. ודאי שהשרת רץ ושה-ngrok מפנה אליו');
    return finishDiagnose_(false);
  }
  if (info.signing === 'off') {
    say(false, 'The backend has no MG_HMAC_SECRET (development mode), so it cannot sign its answers',
      'בשרת לא מוגדר סוד משותף (מצב פיתוח), ולכן התשובות לא חתומות. בפריסה ל-Cloud Run הריצי שוב את deploy_backend.sh; ' +
      'בהרצה מקומית הגדירי MG_HMAC_SECRET בקובץ .env עם אותו ערך כמו HMAC_SECRET בתוסף');
    return finishDiagnose_(false);
  }
  if (!info.signing) {
    say(false, 'The backend is an older version (' + (info.version || '?') + ') without signed answers - redeploy it',
      'השרת הפרוס הוא גרסה ישנה שלא חותמת תשובות. פרסי מחדש: ./scripts/deploy_backend.sh מתוך החבילה החדשה');
    return finishDiagnose_(false);
  }

  // 3. A signed analysis of a tiny synthetic email (checks the secret and response signing)
  try {
    var r = callBackend_({
      client_version: 'diagnose', raw_headers: 'From: Test <test@example.com>\r\nSubject: MailGuard self-check',
      text_body: 'hello', html_body: '', attachments: [], sender_history: null, recipient_domain: '', locale: 'en'
    }, getConfig_());
    say(true, 'Signed analysis works: score ' + r.score + ' (' + r.verdict + '), engine ' + r.engine_version,
      'בקשה חתומה עובדת - הסוד תואם והתשובה חתומה כראוי');
  } catch (err) {
    var hints = {
      auth: 'הסוד בתוסף שונה מהסוד בשרת. העתיקי שוב: gcloud secrets versions access latest --secret mg-hmac-secret',
      untrusted: 'התשובה לא נחתמה בסוד הזה. ' + (err.detail || '') + ' - פרסי מחדש את השרת מהחבילה החדשה וודאי ש-HMAC_SECRET זהה לסוד בשרת',
      rate: 'יותר מדי בקשות - חכי דקה ונסי שוב',
      busy: 'השרת עמוס - נסי שוב בעוד כמה שניות'
    };
    say(false, 'Signed analysis failed: ' + (err.kind || err.name) + ' ' + (err.detail || ''),
      hints[err.kind] || 'הבקשה החתומה נכשלה - ראי ב-Cloud Run ← Logs');
  }

  // 4. Gmail API advanced service (sender history, actions, alerts)
  try {
    Gmail.Users.Labels.list('me');
    say(true, 'Gmail API advanced service is enabled', 'שירות Gmail API מופעל');
  } catch (err) {
    say(false, 'Gmail API advanced service: ' + String(err.message || err).slice(0, 100),
      'הפעילי את Gmail API: בעורך ← Services (+) ← Gmail API ← Add');
  }
  return finishDiagnose_(ok);
}

function finishDiagnose_(ok) {
  console.log(ok
    ? '\n🎉 Everything MailGuard needs is working. Refresh Gmail and open an email.\n   הכול תקין. רענני את Gmail ופתחי מייל.'
    : '\n🔧 Fix the first ❌ above and run diagnose() again.\n   תקני את ה-❌ הראשון ברשימה והריצי שוב.');
  return ok;
}

// ===================================================================== Extract.gs

/**
 * Builds the request for the backend from the open message.
 *
 * Data minimisation: we send headers, bodies, attachment metadata + SHA-256, the
 * contents of small inspectable attachments, the recipient's *domain* and a two-number
 * summary of the sender history (counts and flags only). We never send the recipient address, other messages,
 * or large attachment contents.
 */

function buildPayload_(message, messageId, config) {
  var fromHeader = message.getFrom();
  var senderEmail = emailFromHeader_(fromHeader);
  var userEmail = Session.getActiveUser().getEmail() || '';

  return {
    client_version: 'addon-' + MG.VERSION,
    raw_headers: safeSlice_(rawHeaders_(message, messageId), MG.MAX_HEADER_CHARS),
    text_body: safeSlice_(message.getPlainBody(), MG.MAX_TEXT_CHARS),
    html_body: safeSlice_(message.getBody(), MG.MAX_HTML_CHARS),
    attachments: attachmentsOf_(message),
    sender_history: config.senderHistory ? getSenderHistory_(senderEmail, messageId) : null,
    recipient_domain: userEmail.indexOf('@') > 0 ? userEmail.split('@')[1].toLowerCase() : '',
    locale: MG_LOCALE_ // explanations come back in the user's Gmail language
  };
}

/**
 * The header block exactly as Gmail stored it, in order. Order matters: the backend only
 * trusts the top-most Authentication-Results header (the one Gmail added).
 * Uses the Gmail API's metadata view via the Gmail advanced service (no body or attachment
 * bytes are downloaded); falls back to slicing the raw message if that call is unavailable.
 */
function rawHeaders_(message, messageId) {
  try {
    var meta = Gmail.Users.Messages.get('me', messageId, { format: 'metadata' });
    var headers = (meta && meta.payload && meta.payload.headers) || [];
    if (headers.length) {
      return headers.map(function (h) { return h.name + ': ' + h.value; }).join('\r\n');
    }
  } catch (err) {
    console.warn('metadata fetch failed, falling back to raw content: ' + err.name);
  }
  var raw = message.getRawContent();
  var end = raw.search(/\r?\n\r?\n/);
  return end === -1 ? raw.slice(0, MG.MAX_HEADER_CHARS) : raw.slice(0, end);
}

function attachmentsOf_(message) {
  var out = [];
  var inspectedBytes = 0;
  var atts = message.getAttachments({ includeInlineImages: false, includeAttachments: true });
  for (var i = 0; i < atts.length && out.length < MG.MAX_ATTACHMENTS; i++) {
    var att = atts[i];
    var bytes = att.getBytes();
    var name = String(att.getName() || '');
    var item = {
      filename: safeSlice_(name, 512),
      content_type: String(att.getContentType() || 'application/octet-stream').slice(0, 255),
      size: bytes.length,
      sha256: sha256Hex_(bytes),
      content_b64: null
    };
    var inspectable = MG.INSPECTABLE_EXT.indexOf(extensionOf_(name)) !== -1;
    if (inspectable && bytes.length <= MG.MAX_INSPECT_BYTES &&
        inspectedBytes + bytes.length <= MG.MAX_INSPECT_TOTAL_BYTES) {
      item.content_b64 = Utilities.base64Encode(bytes);
      inspectedBytes += bytes.length;
    }
    out.push(item);
  }
  return out;
}

// ===================================================================== History.gs

/**
 * The user's history with the sender, computed inside the user's own Google account.
 *
 * Two sources:
 *  1. Gmail itself - how many earlier messages came from this address, whether the user
 *     ever wrote to it, and whether Gmail already put mail from it in Spam.
 *  2. MailGuard's own memory - earlier verdicts for this sender (and its domain), and
 *     whether the user reported or blocked it. A sender who sent you a malicious email
 *     last week should not start from zero today.
 *
 * Privacy of the memory:
 *  - It lives in the user's own UserProperties (never on the backend, never shared).
 *  - Addresses, domains and message ids are stored only as salted SHA-256 hashes; the
 *    salt is random per user. Reading the store does not reveal who wrote to you.
 *  - It is bounded (MG.HISTORY_MAX_RECORDS) and the oldest records are pruned.
 *
 * The backend receives only counts and flags (see SenderHistory in the backend schemas).
 */

var FREE_MAIL_ = ['gmail.com', 'googlemail.com', 'outlook.com', 'hotmail.com', 'live.com', 'yahoo.com', 'icloud.com',
  'me.com', 'aol.com', 'proton.me', 'protonmail.com', 'gmx.com', 'gmx.net', 'mail.ru', 'yandex.ru', 'walla.co.il',
  'walla.com', 'zoho.com'];

function getSenderHistory_(senderEmail, currentMessageId) {
  // Validating the address also prevents Gmail-search operator injection
  // (e.g. a From of "x@y.com OR in:anywhere").
  if (!isPlainEmail_(senderEmail)) {
    return null;
  }
  // Mail "from yourself" is never familiar: of course you have written to your own address,
  // and spoofing the victim's own address is a common scam ("I hacked your account").
  if (ownAddresses_().indexOf(canonicalGmail_(senderEmail)) !== -1) {
    return null;
  }
  try {
    var received = gmailSearchIds_('from:' + senderEmail + ' -in:chats', MG.HISTORY_LOOKBACK, false)
      .filter(function (id) { return id !== currentMessageId; });
    var sent = gmailSearchIds_('in:sent to:' + senderEmail, 1, false);
    var spam = gmailSearchIds_('in:spam from:' + senderEmail, 10, true)
      .filter(function (id) { return id !== currentMessageId; });
    var record = verdictRecord_(senderEmail, currentMessageId);
    return {
      prior_messages_from_sender: received.length,
      user_has_emailed_sender: sent.length > 0,
      prior_malicious_verdicts: record.malicious,
      prior_suspicious_verdicts: record.suspicious,
      reported_sender: record.reported,
      blocked_sender: record.blocked,
      prior_spam_messages: spam.length,
      domain_prior_malicious: record.domainMalicious
    };
  } catch (err) {
    console.warn('sender history unavailable: ' + err.name);
    return null; // the backend reports "not provided" instead of guessing
  }
}

function gmailSearchIds_(query, maxResults, includeSpamTrash) {
  var resp = Gmail.Users.Messages.list('me', { q: query, maxResults: maxResults, includeSpamTrash: !!includeSpamTrash });
  return ((resp && resp.messages) || []).map(function (m) { return m.id; });
}

/** gmail.com and googlemail.com are the same mailbox. */
function canonicalGmail_(email) {
  return String(email || '').toLowerCase().replace(/@googlemail\.com$/, '@gmail.com');
}

/** The user's own address plus their send-as aliases (cached for 6 hours). */
function ownAddresses_() {
  var cache = CacheService.getUserCache();
  var hit = cache.get('mg:own-addresses');
  if (hit) {
    return JSON.parse(hit);
  }
  var out = [canonicalGmail_(Session.getActiveUser().getEmail())];
  try {
    (Gmail.Users.Settings.SendAs.list('me').sendAs || []).forEach(function (a) {
      if (isPlainEmail_(a.sendAsEmail)) {
        out.push(canonicalGmail_(a.sendAsEmail));
      }
    });
  } catch (err) {
    console.warn('send-as aliases unavailable: ' + err.name);
  }
  cache.put('mg:own-addresses', JSON.stringify(out), 6 * 3600);
  return out;
}

// ----------------------------------------------------------------------------- verdict memory

/** Per-user random salt, created on first use. */
function historySalt_() {
  var props = PropertiesService.getUserProperties();
  var salt = props.getProperty('mg:salt');
  if (!salt) {
    salt = Utilities.getUuid() + Utilities.getUuid();
    props.setProperty('mg:salt', salt);
  }
  return salt;
}

function saltedHash_(value, length) {
  var bytes = Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, historySalt_() + '|' + value,
    Utilities.Charset.UTF_8);
  return bytesToHex_(bytes).slice(0, length || 24);
}

function senderKey_(email) {
  return 'mg:s:' + saltedHash_('s:' + canonicalGmail_(email));
}

/** Domain records only for organisation domains: "gmail.com sent malware" says nothing. */
function domainKey_(email) {
  var domain = String(email).split('@')[1] || '';
  return !domain || FREE_MAIL_.indexOf(domain) !== -1 ? null : 'mg:d:' + saltedHash_('d:' + domain);
}

function readRecord_(props, key) {
  try {
    var r = JSON.parse(props.getProperty(key) || 'null');
    return r && typeof r === 'object' ? r : {};
  } catch (err) {
    return {};
  }
}

/** Counts for the current analysis; the message being analysed never counts against itself. */
function verdictRecord_(senderEmail, currentMessageId) {
  var empty = { malicious: 0, suspicious: 0, reported: false, blocked: false, domainMalicious: 0 };
  try {
    var props = PropertiesService.getUserProperties();
    var self = currentMessageId ? saltedHash_('m:' + currentMessageId, 16) : '';
    var notSelf = function (h) { return h !== self; };
    var s = readRecord_(props, senderKey_(senderEmail));
    var dk = domainKey_(senderEmail);
    var d = dk ? readRecord_(props, dk) : {};
    return {
      malicious: (s.m || []).filter(notSelf).length,
      suspicious: (s.s || []).filter(notSelf).length,
      reported: !!s.r,
      blocked: !!s.b,
      domainMalicious: (d.m || []).filter(notSelf).length
    };
  } catch (err) {
    console.warn('verdict memory unavailable: ' + err.name);
    return empty;
  }
}

/** Remember this message's verdict (a re-scan replaces the earlier verdict for the same message). */
function recordVerdict_(senderEmail, messageId, verdict) {
  if (!isPlainEmail_(senderEmail) || !messageId || ownAddresses_().indexOf(canonicalGmail_(senderEmail)) !== -1) {
    return; // your own address is never "a sender" (see getSenderHistory_)
  }
  updateRecords_(senderEmail, function (s, d) {
    var h = saltedHash_('m:' + messageId, 16);
    var without = function (list) { return (list || []).filter(function (x) { return x !== h; }); };
    s.m = without(s.m);
    s.s = without(s.s);
    if (verdict === 'malicious') {
      s.m = s.m.concat([h]).slice(-MG.HISTORY_MAX_PER_SENDER);
    } else if (verdict === 'suspicious') {
      s.s = s.s.concat([h]).slice(-MG.HISTORY_MAX_PER_SENDER);
    }
    if (d) {
      d.m = without(d.m);
      if (verdict === 'malicious') {
        d.m = d.m.concat([h]).slice(-MG.HISTORY_MAX_PER_SENDER);
      }
    }
  });
}

/** flag: 'r' (reported) or 'b' (blocked). */
function recordSenderAction_(senderEmail, flag) {
  if (!isPlainEmail_(senderEmail) || (flag !== 'r' && flag !== 'b')) {
    return;
  }
  updateRecords_(senderEmail, function (s) { s[flag] = 1; });
}

/** Read-modify-write under a user lock, then prune. Never throws: memory is best effort. */
function updateRecords_(senderEmail, mutate) {
  var lock = LockService.getUserLock();
  if (!lock.tryLock(3000)) {
    console.warn('verdict memory busy; not recorded');
    return;
  }
  try {
    var props = PropertiesService.getUserProperties();
    var sk = senderKey_(senderEmail);
    var dk = domainKey_(senderEmail);
    var s = readRecord_(props, sk);
    var d = dk ? readRecord_(props, dk) : null;
    mutate(s, d);
    var now = Math.floor(Date.now() / 1000);
    var writes = {};
    if ((s.m || []).length || (s.s || []).length || s.r || s.b) {
      s.t = now;
      writes[sk] = JSON.stringify(s);
    } else {
      props.deleteProperty(sk);
    }
    if (dk && d) {
      if ((d.m || []).length) {
        d.t = now;
        writes[dk] = JSON.stringify(d);
      } else {
        props.deleteProperty(dk);
      }
    }
    if (Object.keys(writes).length) {
      props.setProperties(writes, false);
    }
    pruneRecords_(props);
  } catch (err) {
    console.warn('verdict memory not updated: ' + err.name);
  } finally {
    lock.releaseLock();
  }
}

/** Keep the store well inside the UserProperties quota by dropping the oldest records. */
function pruneRecords_(props) {
  var all = props.getProperties();
  var keys = Object.keys(all).filter(function (k) { return k.indexOf('mg:s:') === 0 || k.indexOf('mg:d:') === 0; });
  if (keys.length <= MG.HISTORY_MAX_RECORDS) {
    return;
  }
  var age = function (k) {
    try {
      return JSON.parse(all[k]).t || 0;
    } catch (err) {
      return 0;
    }
  };
  keys.sort(function (a, b) { return age(a) - age(b); });
  keys.slice(0, keys.length - MG.HISTORY_MAX_RECORDS).forEach(function (k) { props.deleteProperty(k); });
}

// ===================================================================== Strings.gs

/**
 * UI strings in English and Hebrew.
 *
 * The language follows the user's Gmail language (e.commonEventObject.userLocale, which needs
 * "useLocaleFromApp": true and the script.locale scope in the manifest). The backend gets
 * the same locale and writes its findings, summary and recommendations in that language,
 * so the whole card is in one language. Anything without a translation falls back to English.
 *
 * Strings are templates: t_('key', { name: value }) replaces {name}. Values are inserted
 * as-is, so callers escape dynamic values (esc_/label_) *before* passing them in.
 */

var MG_LOCALE_ = 'en'; // set once per execution by setLocale_(e)

/** 'he', 'he-IL' and 'iw' (Java's legacy Hebrew code) -> 'he'; everything else -> 'en'. */
function normalizeLocale_(locale) {
  var code = String(locale || 'en').toLowerCase().replace('_', '-').split('-')[0];
  if (code === 'iw') {
    code = 'he';
  }
  return STRINGS_[code] ? code : 'en';
}

function setLocale_(e) {
  var raw = (e && e.commonEventObject && e.commonEventObject.userLocale) ||
    (e && e.userLocale) || // older event shape
    '';
  MG_LOCALE_ = normalizeLocale_(raw);
  if (raw) {
    // Remembered for background alerts, which run without an event (Alerts.gs).
    try {
      var props = PropertiesService.getUserProperties();
      if (props.getProperty('mg:locale') !== MG_LOCALE_) {
        props.setProperty('mg:locale', MG_LOCALE_);
      }
    } catch (err) {
      // best effort
    }
  }
  return MG_LOCALE_;
}

function t_(key, vars) {
  var table = STRINGS_[MG_LOCALE_] || STRINGS_.en;
  var s = table[key] !== undefined ? table[key] : STRINGS_.en[key];
  if (s === undefined) {
    return key;
  }
  return !vars ? s : s.replace(/\{(\w+)\}/g, function (m, name) {
    return vars[name] !== undefined ? String(vars[name]) : m;
  });
}

/** Category names come from the backend in English (they are also icon keys). */
function categoryLabel_(category) {
  return (MG_LOCALE_ === 'he' && CATEGORY_HE_[category]) || category;
}

