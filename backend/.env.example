# Copy to .env for local development. NEVER commit real values.
MG_ENV=dev
MG_HMAC_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
MG_VIRUSTOTAL_API_KEY=
MG_SAFE_BROWSING_API_KEY=
MG_ENABLE_RDAP=true
# Comma-separated domains of your organisation, protected from look-alikes
MG_PROTECTED_DOMAINS=
